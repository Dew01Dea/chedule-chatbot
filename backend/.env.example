# ---------------------------------------------------------------------------
# Typhoon (OCR + chat). Get a key at
# https://playground.opentyphoon.ai/settings/api-key
# ---------------------------------------------------------------------------
TYPHOON_API_KEY=

# ---------------------------------------------------------------------------
# Supabase. Without both of these the server falls back to read-only mode
# against backend/data/schedule.json and cannot support multiple teachers.
#
# The key is the server-side one: Supabase labels it "service_role" in older
# projects and "Secret key" in newer ones. Either variable name below works;
# set only one. It is NOT the anon / publishable key.
#
# This key bypasses Row Level Security. It is server-only: never expose it to
# the frontend and never commit it.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Admin access, as "name:token" pairs separated by commas. The name is
# recorded against schedules that person publishes and rows they correct.
# Generate tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Admin endpoints refuse every request while this is empty.
# ---------------------------------------------------------------------------
ADMIN_TOKENS=

# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the API in production,
# e.g. https://schedule.example.ac.th
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# poppler. Only needed if pdftoppm is not on the server process's PATH, which
# is common on Windows: a process inherits PATH at launch, and an editor's
# terminal inherits it from the editor. Point this at poppler's bin directory
# and PATH stops mattering.
#   Windows: POPPLER_PATH=C:\poppler\Library\bin
#   macOS:   POPPLER_PATH=/opt/homebrew/bin
# ---------------------------------------------------------------------------
POPPLER_PATH=

# Timezone all schedule dates are computed in.
APP_TIMEZONE=Asia/Bangkok

PORT=4000
