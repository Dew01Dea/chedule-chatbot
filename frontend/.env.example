# ---------------------------------------------------------------------------
# Where the backend lives, e.g. https://schedule-chatbot-api.onrender.com
#
# Leave this unset for local development: `npm run dev` proxies /api to
# http://localhost:4000, so a relative path already reaches the backend.
#
# Vite inlines VITE_* variables at BUILD time, not at runtime, so changing this
# on the host requires a rebuild/redeploy — it is not read from the server.
# Nothing secret belongs here: whatever is set ships inside the public bundle.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
