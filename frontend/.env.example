# ---------------------------------------------------------------------------
# Where the backend lives.
#
# Leave this UNSET for both local development and the default Vercel
# deployment. In development `npm run dev:frontend` proxies /api to
# http://localhost:4000; on Vercel the backend runs as a function on the same
# origin. In both cases a relative /api path already reaches it.
#
# Set it only to point the frontend at a backend on a different host, e.g. a
# container running the full pipeline:
#   VITE_API_BASE_URL=https://schedule-chatbot-api.onrender.com
#
# Vite inlines VITE_* variables at BUILD time, not at runtime, so changing this
# on the host requires a redeploy. Nothing secret belongs here: whatever is set
# ships inside the public bundle.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
